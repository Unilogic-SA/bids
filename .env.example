ETENDERS_PAGE_SIZE=20000
ETENDERS_MAX_PAGES=20
ETENDERS_BACKFILL_MONTHS=36
ETENDERS_DAILY_LOOKBACK_DAYS=14
ETENDERS_RETRY_ATTEMPTS=5
ETENDERS_RETRY_DELAY_MS=3000
