# Set explicitly per environment. Never derive auth callbacks from forwarded hosts.
CUSTOMER_AUTH_SITE_URL=http://localhost:3000
# Server-only signing secret, at least 32 random bytes; store securely, never commit.
CUSTOMER_AUTH_RECOVERY_SECRET=

