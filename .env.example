NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://bids-za.vercel.app
# Optional GA4 web-stream measurement ID (public identifier, not an API secret).
# Leave blank to disable Google measurement. Configure the stream as documented
# in docs/google-campaign-measurement.md before enabling.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
SUPABASE_SERVICE_ROLE_KEY=
ETENDERS_SYNC_SECRET=

# Set explicitly per environment. Never derive auth callbacks from forwarded hosts.
CUSTOMER_AUTH_SITE_URL=http://localhost:3000
# Server-only signing secret, at least 32 random bytes; store securely, never commit.
CUSTOMER_AUTH_RECOVERY_SECRET=

ETENDERS_OCDS_URL=https://ocds-api.etenders.gov.za/api/OCDSReleases
ETENDERS_PAGE_SIZE=20000
ETENDERS_MAX_PAGES=20
ETENDERS_BACKFILL_MONTHS=36
ETENDERS_DAILY_LOOKBACK_DAYS=14
ETENDERS_RETRY_ATTEMPTS=5
ETENDERS_RETRY_DELAY_MS=3000

# Invitation sending is opt-in; use separate keys/origins for each environment.
WORKSPACE_INVITATIONS_ENABLED=false
RESEND_API_KEY=
WORKSPACE_INVITE_FROM=OpenBids <no-reply@openbid.co.za>
